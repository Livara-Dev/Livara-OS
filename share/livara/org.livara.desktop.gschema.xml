<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.livara.desktop" path="/org/livara/desktop/">
    <key name="theme-enabled" type="b"><default>false</default></key>
    <key name="theme-accent" type="s"><default>'#c5a3ff'</default></key>
    <key name="theme-radius" type="i"><range min="0" max="36"/><default>22</default></key>
    <key name="theme-border" type="i"><range min="0" max="4"/><default>1</default></key>
    <key name="theme-opacity" type="i"><range min="60" max="100"/><default>92</default></key>
    <key name="palette-shortcut" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;space']</default></key>
    <key name="clipboard-shortcut" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;v']</default></key>
    <key name="zone-1" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;1']</default></key>
    <key name="zone-2" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;2']</default></key>
    <key name="zone-3" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;3']</default></key>
    <key name="zone-4" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;4']</default></key>
    <key name="zone-5" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;5']</default></key>
    <key name="zone-6" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;6']</default></key>
    <key name="zone-7" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;7']</default></key>
    <key name="zone-8" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;8']</default></key>
    <key name="zone-9" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;9']</default></key>
    <key name="tiling-zones" type="s"><default>'[[0,0,0.5,1],[0.5,0,0.5,1]]'</default></key>
    <key name="clipboard-history-enabled" type="b"><default>false</default></key>
    <key name="clipboard-excluded-apps" type="as"><default>['org.keepassxc.KeePassXC.desktop', 'com.bitwarden.desktop', 'org.gnome.seahorse.Application.desktop']</default></key>
    <key name="glass-enabled" type="b"><default>true</default><summary>Translucent shell surfaces and background blur</summary></key>
    <key name="blur-radius" type="i"><range min="0" max="60"/><default>24</default><summary>Shell background blur radius</summary></key>
    <key name="accent" type="s"><choices><choice value="blue"/><choice value="purple"/><choice value="sage"/><choice value="bark"/><choice value="orange"/><choice value="red"/><choice value="olive"/><choice value="magenta"/></choices><default>'purple'</default></key>
    <key name="appearance" type="s"><choices><choice value="dark"/><choice value="light"/></choices><default>'dark'</default></key>
    <key name="wallpaper" type="s"><choices><choice value="halo"/><choice value="glass"/><choice value="aurora"/><choice value="dusk"/><choice value="verdant"/></choices><default>'halo'</default></key>
    <key name="window-button-style" type="s"><choices><choice value="traffic-lights"/><choice value="default"/></choices><default>'traffic-lights'</default><summary>Window control appearance</summary></key>
    <key name="window-button-size" type="i"><range min="10" max="22"/><default>14</default><summary>Traffic light diameter in pixels</summary></key>
    <key name="window-button-symbols" type="b"><default>false</default><summary>Show symbols inside traffic light controls</summary></key>
    <key name="window-close-color" type="s"><default>'#ff5f57'</default><summary>Close control color</summary></key>
    <key name="window-minimize-color" type="s"><default>'#febc2e'</default><summary>Minimize control color</summary></key>
    <key name="window-maximize-color" type="s"><default>'#28c840'</default><summary>Green control color</summary></key>
    <key name="window-green-action" type="s"><choices><choice value="fullscreen"/><choice value="maximize"/></choices><default>'fullscreen'</default><summary>Green control action in Livara applications</summary></key>
    <key name="window-animation-style" type="s"><choices><choice value="zoom"/><choice value="lift"/><choice value="fade"/><choice value="off"/></choices><default>'zoom'</default><summary>Window opening and closing transition</summary></key>
    <key name="window-animation-duration" type="i"><range min="80" max="600"/><default>180</default><summary>Window transition duration in milliseconds</summary></key>
  </schema>
</schemalist>
