[Desktop Entry]
Type=Application
Name=Livara Browser
Comment=Browse the web with Livara
Exec=livara-browser %U
Icon=org.livara.Browser
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=org.livara.Browser
DBusActivatable=false
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
Actions=TorMode;

[Desktop Action TorMode]
Name=Open Official Tor Browser
Exec=livara-browser --tor
Icon=org.livara.Browser
