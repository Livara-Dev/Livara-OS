# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS node
FROM ubuntu:24.04 AS builder
ARG DEBIAN_FRONTEND=noninteractive
ARG LIVARA_BUILD_JOBS=4
COPY --from=node /usr/local/ /usr/local/
RUN --mount=type=secret,id=livara_build_ca \
    set -eu; \
    if [ -s /run/secrets/livara_build_ca ]; then printf 'Acquire::https::CaInfo "/run/secrets/livara_build_ca";\n' > /etc/apt/apt.conf.d/99livara-build-ca; fi; \
    apt-get update && apt-get install -y --no-install-recommends \
    autoconf2.13 build-essential ca-certificates clang curl file git lld llvm \
    libasound2-dev libdbus-glib-1-dev libdrm-dev libegl1-mesa-dev libffi-dev \
    libgtk-3-dev libnotify-dev libpci-dev libpulse-dev libssl-dev libx11-xcb-dev \
    libxt-dev mercurial nasm pkg-config python3 python3-dev python3-pil \
    python3-pip python3-venv sudo unzip xz-utils yasm zip zstd \
    && rm -rf /var/lib/apt/lists/* && rm -f /etc/apt/apt.conf.d/99livara-build-ca
RUN groupadd --gid 1001 builder && useradd --create-home --uid 1001 --gid 1001 builder && mkdir -p /project /artifacts && chown builder:builder /project /artifacts
COPY --chown=builder:builder forks/browser /project/forks/browser
COPY --chown=builder:builder src/livara /project/src/livara
COPY --chown=builder:builder LICENSE /project/LICENSE
COPY --chown=builder:builder artwork/livara-browser.png /project/artwork/livara-browser.png
COPY --chown=builder:builder fonts/ttf /project/fonts/ttf
COPY --chown=builder:builder fonts/OFL.txt /project/fonts/OFL.txt
COPY --chown=builder:builder fonts/vendor/vazirmatn/OFL.txt /project/fonts/vendor/vazirmatn/OFL.txt
COPY --chown=builder:builder fonts/vendor/vazirmatn/upstream.json /project/fonts/vendor/vazirmatn/upstream.json
USER builder
ENV PATH="/home/builder/.cargo/bin:${PATH}" \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    LIVARA_BUILD_JOBS=${LIVARA_BUILD_JOBS}
RUN --mount=type=secret,id=livara_build_ca,uid=1001,gid=1001 \
    bash /project/forks/browser/with-build-trust.sh bash -c \
    'curl --proto "=https" --tlsv1.2 --fail --location https://sh.rustup.rs -o /tmp/rustup-init.sh && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.95.0 && rm /tmp/rustup-init.sh'
WORKDIR /project
RUN --mount=type=cache,id=livara-browser-work,target=/home/builder/work,uid=1001,gid=1001 \
    --mount=type=secret,id=livara_build_ca,uid=1001,gid=1001 \
    --mount=type=cache,id=livara-browser-mozbuild,target=/home/builder/.mozbuild,uid=1001,gid=1001 \
    --mount=type=cache,id=livara-browser-cargo-registry,target=/home/builder/.cargo/registry,uid=1001,gid=1001 \
    --mount=type=cache,id=livara-browser-cargo-git,target=/home/builder/.cargo/git,uid=1001,gid=1001 \
    bash forks/browser/with-build-trust.sh bash forks/browser/build-source.sh /home/builder/work /artifacts

FROM scratch AS artifact
COPY --from=builder /artifacts/ /artifacts/
